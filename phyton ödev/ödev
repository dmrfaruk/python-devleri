ortalama=(vize_notu*0.40)+(final_notu*0.60)
if 100>=ortalama>=90:
    print("AA")
elif 89>=ortalama>=85:
    print("BA")
elif 84>=ortalama>=75:
    print("BB")
elif 74>=ortalama>=70:
    print("CB")    
elif 69>=ortalama>=60:
    print("CC")
elif 59>=ortalama>=50:
    print("DC")
elif 49>=ortalama>=40:
    print("DD")
else:
    print("FF")